// Secrets.example.xcconfig
//
// Copy this file to `Secrets.xcconfig` (which is git-ignored) and fill in the
// address of your Kalorias backend for each build configuration:
//
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// THERE IS NO API KEY HERE, AND THERE MUST NEVER BE ONE. The app talks only to
// the Kalorias backend, which owns the analysis prompt, the response schema and
// the AI-provider credential. The app holds an address and nothing else.
//
// `$(SLASH)` IS NOT DECORATION. In an xcconfig file `//` starts a comment
// *inside a value*, so a literal `https://example.com` silently becomes
// `https:` — a URL that parses fine and resolves to nothing, producing a
// generic service error on every analysis with no clue why.
//
// On a PHYSICAL DEVICE `localhost` is the phone, not your Mac. Prefer its
// stable Bonjour hostname (`scutil --get LocalHostName`) over a DHCP address.
SLASH = /
KALORIAS_API_BASE_URL_Debug = http:$(SLASH)$(SLASH)your-mac.local:8001
KALORIAS_API_BASE_URL_Release = https:$(SLASH)$(SLASH)your-server.example
KALORIAS_API_BASE_URL = $(KALORIAS_API_BASE_URL_$(CONFIGURATION))

// Approved release inputs from Product/Legal. The app refuses to record or
// upload consent while any value is absent or invalid; identifiers must be
// 1...32 characters. Keep the URL escaped because a literal `//` is truncated.
PRIVACY_POLICY_URL = https:$(SLASH)$(SLASH)doc-hosting.flycricket.io/kalorias-privacy-policy/24980b31-739a-458e-8f6f-709e2eb49030/privacy
PRIVACY_NOTICE_VERSION = 2026-09-08
HEALTH_DATA_CONSENT_VERSION = 2026-09-08

// Required before publishing a questionnaire schema that older clients cannot
// render. Use the public listing created by App Store Connect, escaping `//`:
// https:$(SLASH)$(SLASH)apps.apple.com/app/id1234567890
APP_STORE_URL =
