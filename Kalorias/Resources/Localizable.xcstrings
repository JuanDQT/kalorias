    "camera.capture": {
      "comment": "Accessibility label for the capture button",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomar foto"
          }
        }
      }
    },
    "camera.library": {
      "comment": "Accessibility label for the bottom-left control on the camera screen that opens the system photo picker, as an alternative to taking a photo.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose from library"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir de la biblioteca"
          }
        }
      }
    },
    "camera.library.failed": {
      "comment": "Shown when a photo picked from the library cannot be decoded (unsupported format, failed iCloud download). The live camera preview resumes afterwards.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That photo could not be opened. Try another one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir esa foto. Prueba con otra."
          }
        }
      }
    },
    "camera.preparing": {
      "comment": "Loading state shown while a picked library photo is being loaded and resized before it can be sent.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing photo…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando foto…"
          }
        }
      }
    },
    "camera.send": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar"
          }
        }
      }
    },
    "camera.sendFrame.label": {
      "comment": "Accessibility label for the framing rectangle on the camera screen. States the CONSEQUENCE of the frame rather than describing a rectangle: a user who cannot see it needs to know content outside the frame is discarded before sending.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only what is inside this frame will be analyzed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se analizará lo que esté dentro de este recuadro"
          }
        }
      }
    },
    "camera.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera isn’t available on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no está disponible en este dispositivo."
          }
        }
      }
    },
    "camera.zoom.indicator": {
      "comment": "Current camera zoom, shown only when zoomed in. %@ is the formatted factor, e.g. \"2.5\". The multiplication sign is the same in both languages.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@×"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@×"
          }
        }
      }
    },
    "camera.zoom.label": {
      "comment": "Accessibility label for the camera zoom control. Adjustable, so VoiceOver users can change zoom without performing a pinch gesture.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom"
          }
        }
      }
    },
    "history.date.rowFormat": {
      "comment": "Timestamp on a history list row, e.g. \"Fri. 25 Jul, 16:40\". %1$@ is the abbreviated weekday including its trailing period (e.g. \"Fri.\"), %2$@ is the day number (e.g. \"25\"), %3$@ is the abbreviated month (e.g. \"Jul\"), %4$@ is the time, already formatted for the device's 12/24-hour setting. Reorder as your language requires.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@, %4$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@, %4$@"
          }
        }
      }
    },
    "history.empty.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your analyzed meals will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus comidas analizadas aparecerán aquí."
          }
        }
      }
    },
    "history.empty.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No meals yet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay comidas"
          }
        }
      }
    },
    "history.kcalUnit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "kcal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "kcal"
          }
        }
      }
    },
    "history.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Historial"
          }
        }
      }
    },
    "history.week.current": {
      "comment": "History section header above meals captured during the week currently in progress.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Semana actual"
          }
        }
      }
    },
    "history.week.dayMonth": {
      "comment": "One end of a history week range, within the current year. %1$@ is the day number (e.g. \"1\"), %2$@ is the full month name (e.g. \"February\"). Reorder for languages that put the month first.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "history.week.dayMonthYear": {
      "comment": "One end of a history week range, in an earlier year. %1$@ is the day number (e.g. \"1\"), %2$@ is the full month name (e.g. \"February\"), %3$@ is the year (e.g. \"2025\"). Reorder as your language requires.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@"
          }
        }
      }
    },
    "history.week.previous": {
      "comment": "History section header above meals captured during the week immediately before the current one.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last week"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Semana anterior"
          }
        }
      }
    },
    "history.week.range": {
      "comment": "History week header for older weeks: a date range. %1$@ is the start date (e.g. \"1 February\"), %2$@ is the end date (e.g. \"7 February\"). Reorder or change the separator as your language requires.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ - %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ - %2$@"
          }
        }
      }
    },
    "mealDetails.takenAt": {
