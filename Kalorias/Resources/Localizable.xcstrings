    },
    "analysis.error.invalidResponse": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t read the result. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos leer el resultado. Inténtalo de nuevo."
          }
        }
      }
    },
    "analysis.error.noConnection": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet connection. Check your network and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión a internet. Revisa tu red e inténtalo de nuevo."
          }
        }
      }
    },
    "analysis.error.service": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service had a problem. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio tuvo un problema. Inténtalo de nuevo."
          }
        }
      }
    },
