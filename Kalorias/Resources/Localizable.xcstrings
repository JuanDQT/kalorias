    "permission.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalorias needs access to your camera to take a photo of your food and estimate its calories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalorias necesita acceso a tu cámara para tomar una foto de tu comida y estimar sus calorías."
          }
        }
      }
    },
    "permission.continue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "es": {
