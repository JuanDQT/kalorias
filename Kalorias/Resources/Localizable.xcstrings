{
  "sourceLanguage": "en",
  "strings": {
    "%lld": {
      "comment": "A label that reads \"2000 kcal\"",
      "isCommentAutoGenerated": true
    },
    "%lldg": {
      "comment": "A label displaying the number of grams of a specific macronutrient. The argument is the name of the macronutrient.",
      "isCommentAutoGenerated": true
    },
    "analysis.analyzing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyzing…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizando…"
          }
        }
      }
    },
