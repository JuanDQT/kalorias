    "access.body.pending" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your answers are on this device only. Sign in with Apple to create your Kalorias account — we'll ask separately before sending anything."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus respuestas están solo en este dispositivo. Inicia sesión con Apple para crear tu cuenta de Kalorias; te pediremos permiso aparte antes de enviar nada."
          }
        }
      }
    },
    "access.body.returning" : {
