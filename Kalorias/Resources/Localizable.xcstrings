          "stringUnit": {
            "state": "translated",
            "value": "Camera access"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso a la cámara"
          }
        }
      }
    },
    "progress.change.down": {
      "comment": "Accessibility label for a decrease vs the previous week. %@ is a formatted percentage such as '12%'.",
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Down %@ versus last week"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja %@ respecto a la semana anterior"
          }
        }
      }
    },
    "progress.change.unchanged": {
      "comment": "Accessibility label when the figure did not change measurably vs the previous week.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same as last week"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Igual que la semana anterior"
          }
        }
      }
    },
    "progress.change.up": {
      "comment": "Accessibility label for an increase vs the previous week. %@ is a formatted percentage such as '12%'.",
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up %@ versus last week"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube %@ respecto a la semana anterior"
          }
        }
      }
    },
    "progress.chart.average": {
      "comment": "Label on the chart's average line. The average covers only days that have a log.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Media"
          }
        }
      }
    },
    "progress.chart.noData": {
      "comment": "Announced for a day with no logged meals. Must NOT read as zero calories.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "no data"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "sin datos"
          }
        }
      }
    },
    "progress.chart.title": {
      "comment": "Header of the 7-day calorie chart. States the period, which is a ROLLING 7 days and deliberately differs from the weekly summary card's calendar week.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last 7 days"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Últimos 7 días"
          }
        }
      }
    },
    "progress.empty.message": {
      "comment": "Body of the Progress tab empty state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyze a meal and your stats will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza una comida y tus estadísticas aparecerán aquí."
          }
        }
      }
    },
    "progress.empty.title": {
      "comment": "Title of the Progress tab empty state, shown when no meal has ever been analyzed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing logged yet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay registros"
          }
        }
      }
    },
    "progress.title": {
      "comment": "Navigation title of the Progress tab.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Progreso"
          }
        }
      }
    },
    "progress.unavailable": {
      "comment": "Placeholder shown when a figure cannot be computed. Must not read as a zero value.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "—"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "—"
          }
        }
      }
    },
    "progress.week.average": {
      "comment": "Label for the average across days that have at least one logged meal (not per calendar day).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average per logged day"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Media por día registrado"
          }
        }
      }
    },
    "progress.week.highest": {
      "comment": "Label for the day of the week with the highest logged total.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highest day"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Día más alto"
          }
        }
      }
    },
    "progress.week.meals": {
      "comment": "Label for how many meals were logged this week.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meals logged"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comidas registradas"
          }
        }
      }
    },
    "progress.week.noData": {
      "comment": "Shown in the weekly summary card when meals exist in earlier weeks but nothing has been logged in the current week. Deliberately not a row of zeros.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing logged this week"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada registrado esta semana"
          }
        }
      }
    },
    "progress.week.title": {
      "comment": "Header of the weekly summary card. Also states the period the card covers.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta semana"
          }
        }
      }
    },
    "progress.week.total": {
      "comment": "Label for the week's total. Says 'logged' deliberately: the user photographs some meals, not all, so this is never presented as their actual intake.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calories logged"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calorías registradas"
          }
        }
      }
    },
    "tab.history": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Historial"
          }
        }
