{
  "onboardingId": "plan_v1",
  "schemaVersion": 1,
  "contentVersion": 4,
  "locale": "en",
  "sections": [
    {
      "id": "intro",
      "title": "Welcome",
      "countsTowardProgress": false,
      "questions": [
        {
          "id": "welcome",
          "stage": "onboarding",
          "type": "info",
          "prompt": [
            "Hi there! 👋",
            "I'll ask you a few questions to build your plan. It takes under two minutes, and you can change any answer before you finish."
          ],
          "continueLabel": "Start"
        }
      ]
    },
    {
      "id": "goals",
      "title": "Your goals",
      "subtitle": "So we know where we're headed",
      "questions": [
        {
          "id": "goal_primary",
          "stage": "onboarding",
          "type": "single_choice",
          "prompt": [
            "What do you want to get out of Kalorias?"
          ],
          "options": [
            {
              "id": "lose_weight",
              "title": "Lose weight",
              "description": "Drop fat while keeping muscle",
              "emoji": "🔥"
            },
            {
              "id": "maintain",
              "title": "Maintain my weight",
              "description": "Eat better without moving the scale",
              "emoji": "⚖️"
            },
            {
              "id": "gain_muscle",
              "title": "Build muscle",
              "description": "Gain weight in a controlled way",
              "emoji": "💪"
            }
          ]
        },
        {
          "id": "wants_meal_plan",
          "stage": "onboarding",
          "type": "single_choice",
          "prompt": [
            "Would you like us to put together a meal plan?"
          ],
          "options": [
            {
              "id": "yes",
              "title": "Yes, suggest one",
              "description": "We'll suggest meals for each day",
              "emoji": "🥗"
            },
            {
              "id": "no",
              "title": "No, just counting",
              "description": "You decide what to eat, I'll keep the count",
              "emoji": "📊"
            }
          ]
        },
        {
          "id": "motivation_level",
          "stage": "onboarding",
          "type": "single_choice",
          "prompt": [
            "How motivated are you feeling right now?"
          ],
          "options": [
            {
              "id": "low",
              "title": "I'm trying",
              "description": "I need you to make this easy",
              "emoji": "🙂"
            },
            {
              "id": "medium",
              "title": "Up for it",
              "description": "I'm going for it",
              "emoji": "😃"
            },
            {
              "id": "high",
              "title": "All in",
              "description": "Nothing's stopping me",
              "emoji": "🚀"
            }
          ]
        },
        {
          "id": "calorie_experience",
          "stage": "onboarding",
          "type": "single_choice",
          "prompt": [
            "Have you counted calories before?"
          ],
          "options": [
            {
              "id": "never",
              "title": "Never",
              "description": "This is my first time",
              "emoji": "🌱"
            },
            {
              "id": "tried",
              "title": "I've tried",
              "description": "I gave up after a few weeks",
              "emoji": "🔁"
            },
            {
              "id": "habitual",
              "title": "Yes, it's a habit",
              "description": "I do it regularly",
              "emoji": "✅"
            }
          ]
        }
      ]
    },
    {
      "id": "about_you",
      "title": "About you",
      "subtitle": "This is how we work out your daily calories",
      "questions": [
        {
          "id": "sex",
          "stage": "onboarding",
          "type": "single_choice",
          "prompt": [
            "What's your biological sex?",
            "It changes the basal metabolism calculation quite a bit, which is why we ask."
          ],
          "options": [
            {
              "id": "male",
              "title": "Male",
              "emoji": "♂️"
            },
            {
              "id": "female",
              "title": "Female",
              "emoji": "♀️"
            },
            {
              "id": "unspecified",
              "title": "Prefer not to say",
              "description": "We'll use a mid-point calculation",
              "emoji": "🤍"
            }
          ]
        },
        {
          "id": "birth_date",
          "stage": "onboarding",
          "type": "date",
          "prompt": [
            "When were you born?"
          ],
          "date": {
            "mode": "date",
            "minDate": "today-100y",
            "maxDate": "today-16y",
            "default": "today-30y",
            "displayFormat": "long"
          }
        },
        {
          "id": "height",
          "stage": "onboarding",
          "type": "measure",
          "prompt": [
            "How tall are you?"
          ],
          "measure": {
            "widget": "wheel",
            "canonicalUnit": "cm",
            "defaultUnit": "ft_in",
            "units": [
              {
                "id": "cm",
                "label": "cm",
                "components": [
                  {
                    "id": "cm",
                    "label": "cm",
                    "min": 120,
                    "max": 240,
                    "step": 1,
                    "default": 170,
                    "decimals": 0,
                    "toCanonical": 1
                  }
                ]
              },
              {
                "id": "ft_in",
                "label": "ft/in",
                "components": [
                  {
                    "id": "ft",
                    "label": "ft",
                    "min": 4,
                    "max": 7,
                    "step": 1,
                    "default": 5,
                    "decimals": 0,
                    "toCanonical": 30.48
                  },
                  {
                    "id": "in",
                    "label": "in",
                    "min": 0,
                    "max": 11,
                    "step": 1,
                    "default": 7,
                    "decimals": 0,
                    "toCanonical": 2.54
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "weight_current",
          "stage": "onboarding",
          "type": "measure",
          "prompt": [
            "How much do you weigh right now?"
          ],
          "measure": {
            "widget": "wheel",
            "canonicalUnit": "kg",
            "defaultUnit": "lb",
            "units": [
              {
                "id": "kg",
                "label": "kg",
                "components": [
                  {
                    "id": "kg",
                    "label": "kg",
                    "min": 30,
                    "max": 250,
                    "step": 0.1,
                    "default": 70,
                    "decimals": 1,
                    "toCanonical": 1
                  }
                ]
              },
              {
                "id": "lb",
                "label": "lb",
                "components": [
                  {
                    "id": "lb",
                    "label": "lb",
                    "min": 66,
                    "max": 550,
                    "step": 0.2,
                    "default": 154,
                    "decimals": 1,
                    "toCanonical": 0.45359237
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "training_frequency",
          "stage": "onboarding",
          "type": "single_choice",
          "prompt": [
            "How many days a week do you train?"
          ],
          "options": [
            {
              "id": "d0",
              "title": "None",
              "description": "I'm not training right now",
              "emoji": "🛋️"
            },
            {
              "id": "d1_2",
              "title": "1 or 2 days",
              "description": "Here and there",
              "emoji": "🚶"
            },
            {
              "id": "d3_4",
              "title": "3 or 4 days",
              "description": "Fairly consistent",
              "emoji": "🏃"
            },
            {
              "id": "d5_6",
              "title": "5 or 6 days",
              "description": "Almost every day",
              "emoji": "🏋️"
            },
            {
              "id": "d7",
              "title": "Every day",
              "description": "No rest days",
              "emoji": "🔥"
            }
          ]
        },
        {
          "id": "lifestyle_activity",
          "stage": "onboarding",
          "type": "single_choice",
          "prompt": [
            "Outside training, what's your day like?",
            "Think about work and how much you move around normally."
          ],
          "options": [
            {
              "id": "sedentary",
              "title": "Sitting most of the day",
              "description": "Office, studying, driving",
              "emoji": "💻"
            },
            {
              "id": "light",
              "title": "On my feet now and then",
              "description": "I get up and walk around often",
              "emoji": "🚶"
            },
            {
              "id": "active",
              "title": "On the move",
              "description": "I walk a lot during the day",
              "emoji": "🏃"
            },
            {
              "id": "very_active",
              "title": "Physical work",
              "description": "I lift things or stand all day",
              "emoji": "🧱"
            }
          ]
        },
        {
          "id": "health_conditions_any",
          "stage": "onboarding",
          "type": "single_choice",
          "prompt": [
            "Do you have any health conditions we should know about?"
          ],
          "options": [
            {
              "id": "yes",
              "title": "Yes",
              "emoji": "🩺"
            },
            {
              "id": "no",
              "title": "No, none",
              "emoji": "👍"
            }
          ]
        },
        {
          "id": "health_conditions",
          "stage": "onboarding",
          "type": "multi_choice",
          "visibleIf": {
            "all": [
              {
                "questionId": "health_conditions_any",
                "operator": "equals",
                "value": "yes"
              }
            ]
          },
          "prompt": [
            "Which ones?",
            "You can pick more than one."
          ],
          "confirmLabel": "Confirm",
          "validation": {
            "minSelections": 1
          },
          "options": [
            {
              "id": "diabetes_t1",
              "title": "Type 1 diabetes",
              "emoji": "🩸"
            },
            {
              "id": "diabetes_t2",
              "title": "Type 2 diabetes",
              "emoji": "🩸"
            },
            {
              "id": "hypertension",
              "title": "High blood pressure",
              "emoji": "❤️"
            },
            {
              "id": "cholesterol",
              "title": "High cholesterol",
              "emoji": "🫀"
            },
            {
              "id": "thyroid",
              "title": "Thyroid",
              "description": "Under- or overactive",
              "emoji": "🦋"
            },
            {
              "id": "pcos",
              "title": "PCOS",
              "description": "Polycystic ovary syndrome",
              "emoji": "🌸"
            },
            {
              "id": "kidney",
              "title": "Kidney problems",
              "emoji": "🫘"
            },
            {
              "id": "eating_disorder",
              "title": "Eating disorder",
              "emoji": "🤍"
            },
            {
              "id": "pregnancy",
              "title": "Pregnant or breastfeeding",
              "emoji": "🤱"
            }
          ],
          "allowsCustom": {
            "enabled": true,
            "label": "Add another",
            "placeholder": "e.g. Coeliac disease",
            "maxItems": 3,
            "maxLength": 60
          }
        },
        {
          "id": "health_disclaimer",
          "stage": "onboarding",
          "type": "info",
          "visibleIf": {
            "all": [
              {
                "questionId": "health_conditions_any",
                "operator": "equals",
                "value": "yes"
              }
            ]
          },
          "prompt": [
            "Thanks for telling me. I'll take it into account, but Kalorias isn't medical advice — check with your doctor or dietitian before changing how you eat."
          ],
          "continueLabel": "Got it"
        },
        {
          "id": "weight_goal",
          "stage": "onboarding",
          "type": "measure",
          "visibleIf": {
            "all": [
              {
                "questionId": "goal_primary",
                "operator": "notEquals",
                "value": "maintain"
              }
            ]
          },
          "prompt": [
            "What's your goal weight?"
          ],
          "measure": {
            "widget": "wheel",
            "canonicalUnit": "kg",
            "unitFollows": "weight_current",
            "defaultFollows": "weight_current",
            "defaultUnit": "lb",
            "units": [
              {
                "id": "kg",
                "label": "kg",
                "components": [
                  {
                    "id": "kg",
                    "label": "kg",
                    "min": 30,
                    "max": 250,
                    "step": 0.1,
                    "default": 65,
                    "decimals": 1,
                    "toCanonical": 1
                  }
                ]
              },
              {
                "id": "lb",
                "label": "lb",
                "components": [
                  {
                    "id": "lb",
                    "label": "lb",
                    "min": 66,
                    "max": 550,
                    "step": 0.2,
                    "default": 143,
                    "decimals": 1,
                    "toCanonical": 0.45359237
                  }
                ]
              }
            ]
          },
          "crossChecks": [
            {
              "severity": "warning",
              "when": {
                "all": [
                  {
                    "questionId": "goal_primary",
                    "operator": "equals",
                    "value": "lose_weight"
                  }
                ]
              },
              "rule": "lessThan",
              "compareTo": "weight_current",
              "message": "You chose to lose weight, but your goal is higher than your current weight. Want to check that?"
            },
            {
              "severity": "warning",
              "when": {
                "all": [
                  {
                    "questionId": "goal_primary",
                    "operator": "equals",
                    "value": "gain_muscle"
                  }
                ]
              },
              "rule": "greaterThan",
              "compareTo": "weight_current",
              "message": "You chose to build muscle, but your goal is lower than your current weight. Want to check that?"
            }
          ]
        },
        {
          "id": "goal_pace_loss",
          "stage": "onboarding",
          "type": "single_choice",
          "visibleIf": {
            "all": [
              {
                "questionId": "goal_primary",
                "operator": "equals",
                "value": "lose_weight"
              }
            ]
          },
          "prompt": [
            "How fast do you want to lose it?"
          ],
          "options": [
            {
              "id": "slow",
              "title": "Easy does it",
              "description": "About 0.5 lb a week. You'll barely notice",
              "emoji": "🐢"
            },
            {
              "id": "steady",
              "title": "Steady",
              "description": "About 1 lb a week. The one we'd recommend",
              "emoji": "🚶"
            },
            {
              "id": "fast",
              "title": "Fast",
              "description": "About 1.5 lb a week. Takes more discipline",
              "emoji": "⚡"
            }
          ]
        },
        {
          "id": "goal_pace_gain",
          "stage": "onboarding",
          "type": "single_choice",
          "visibleIf": {
            "all": [
              {
                "questionId": "goal_primary",
                "operator": "equals",
                "value": "gain_muscle"
              }
            ]
          },
          "prompt": [
            "How fast do you want to gain it?"
          ],
          "options": [
            {
              "id": "slow",
              "title": "Easy does it",
              "description": "About 0.5 lb a week. Less fat along for the ride",
              "emoji": "🐢"
            },
            {
              "id": "steady",
              "title": "Steady",
              "description": "About 1 lb a week",
              "emoji": "🚶"
            }
          ]
        }
      ]
    },
    {
      "id": "nutrition",
      "title": "Your food",
      "subtitle": "So the plan is food you'd actually eat",
      "questions": [
        {
          "id": "diet_type",
          "stage": "onboarding",
          "type": "single_choice",
          "prompt": [
            "Do you follow a particular way of eating?"
          ],
          "options": [
            {
              "id": "balanced",
              "title": "I eat everything",
              "description": "No restrictions",
              "emoji": "🍽️"
            },
            {
              "id": "pescetarian",
              "title": "Pescatarian",
              "description": "Fish yes, meat no",
              "emoji": "🐟"
            },
            {
              "id": "vegetarian",
              "title": "Vegetarian",
              "description": "No meat or fish",
              "emoji": "🥬"
            },
            {
              "id": "vegan",
              "title": "Vegan",
              "description": "Nothing from animals",
              "emoji": "🌱"
            }
          ]
        },
        {
          "id": "has_allergies",
          "stage": "onboarding",
          "type": "single_choice",
          "prompt": [
            "Do you have any allergies or intolerances?"
          ],
          "options": [
            {
              "id": "yes",
              "title": "Yes",
              "emoji": "⚠️"
            },
            {
              "id": "no",
              "title": "No, none",
              "emoji": "👍"
            }
          ]
        },
        {
          "id": "allergies",
          "stage": "onboarding",
          "type": "multi_choice",
          "visibleIf": {
            "all": [
              {
                "questionId": "has_allergies",
                "operator": "equals",
                "value": "yes"
              }
            ]
          },
          "prompt": [
            "What to?",
            "Tick all that apply."
          ],
          "confirmLabel": "Confirm",
          "validation": {
            "minSelections": 1
          },
          "options": [
            {
              "id": "gluten",
              "title": "Gluten",
              "emoji": "🌾"
            },
            {
              "id": "lactose",
              "title": "Lactose",
              "emoji": "🥛"
            },
            {
              "id": "peanut",
              "title": "Peanut",
              "emoji": "🥜"
            },
            {
              "id": "tree_nuts",
              "title": "Tree nuts",
              "description": "Almond, walnut, cashew…",
              "emoji": "🌰"
            },
            {
              "id": "fish",
              "title": "Fish",
              "emoji": "🐟"
            },
            {
              "id": "shellfish",
              "title": "Shellfish",
              "emoji": "🦐"
            },
            {
              "id": "soy",
              "title": "Soy",
              "emoji": "🫘"
            },
            {
              "id": "egg",
              "title": "Egg",
              "emoji": "🥚"
            }
          ],
          "allowsCustom": {
            "enabled": true,
            "label": "Add another",
            "placeholder": "e.g. Sesame",
            "maxItems": 5,
            "maxLength": 40
          }
        },
        {
          "id": "disliked_foods",
          "stage": "profile",
          "type": "multi_choice",
          "prompt": [
            "Anything you really don't like?",
            "I won't put it in your plan."
          ],
          "confirmLabel": "Confirm",
          "validation": {
            "minSelections": 1
          },
          "options": [
            {
              "id": "none",
              "title": "I eat everything",
              "description": "There's nothing I avoid",
              "emoji": "😋",
              "exclusive": true
            },
            {
              "id": "broccoli",
              "title": "Broccoli",
              "emoji": "🥦"
            },
            {
              "id": "mushrooms",
              "title": "Mushrooms",
              "emoji": "🍄"
            },
            {
              "id": "onion",
              "title": "Onion",
              "emoji": "🧅"
            },
            {
              "id": "oily_fish",
              "title": "Oily fish",
              "description": "Sardine, mackerel, tuna…",
              "emoji": "🐟"
            },
            {
              "id": "offal",
              "title": "Offal",
              "description": "Liver, kidneys…",
              "emoji": "🫀"
            },
            {
              "id": "olives",
              "title": "Olives",
              "emoji": "🫒"
            },
            {
              "id": "blue_cheese",
              "title": "Blue cheese",
              "emoji": "🧀"
            },
            {
              "id": "spicy",
              "title": "Spicy food",
              "emoji": "🌶️"
            },
            {
              "id": "tofu",
              "title": "Tofu",
              "emoji": "🧊"
            },
            {
              "id": "legumes",
              "title": "Pulses",
              "description": "Lentils, chickpeas…",
              "emoji": "🫘"
            },
            {
              "id": "cilantro",
              "title": "Coriander",
              "emoji": "🌿",
              "description": "Also called cilantro"
            }
          ],
          "allowsCustom": {
            "enabled": true,
            "label": "Add another",
            "placeholder": "e.g. Eggplant",
            "maxItems": 10,
            "maxLength": 40
          }
        },
        {
          "id": "meal_count",
          "stage": "onboarding",
          "type": "single_choice",
          "visibleIf": {
            "all": [
              {
                "questionId": "wants_meal_plan",
                "operator": "equals",
                "value": "yes"
              }
            ]
          },
          "prompt": [
            "How many times a day do you eat?"
          ],
          "options": [
            {
              "id": "two",
              "title": "2 meals",
              "description": "I usually skip one",
              "emoji": "🍳"
            },
            {
              "id": "three",
              "title": "3 meals",
              "description": "Breakfast, lunch and dinner",
              "emoji": "🍽️"
            },
            {
              "id": "four_five",
              "title": "4 or 5",
              "description": "With snacks in between",
              "emoji": "🥪"
            },
            {
              "id": "intermittent",
              "title": "Intermittent fasting",
              "description": "I eat within a time window",
              "emoji": "⏱️"
            }
          ]
        },
        {
          "id": "cooking_time",
          "stage": "onboarding",
          "type": "single_choice",
          "visibleIf": {
            "all": [
              {
                "questionId": "wants_meal_plan",
                "operator": "equals",
                "value": "yes"
              }
            ]
          },
          "prompt": [
            "How much time do you have to cook on weekdays?"
          ],
          "options": [
            {
              "id": "under_15",
              "title": "Under 15 min",
              "description": "As fast as possible",
              "emoji": "⚡"
            },
            {
              "id": "15_30",
              "title": "15 to 30 min",
              "description": "Enough to make something",
              "emoji": "⏲️"
            },
            {
              "id": "over_30",
              "title": "Over 30 min",
              "description": "I like cooking",
              "emoji": "👨‍🍳"
            },
            {
              "id": "no_cooking",
              "title": "I barely cook",
              "description": "I eat out or buy prepared food",
              "emoji": "🥡"
            }
          ]
        },
        {
          "id": "extra_notes",
          "stage": "onboarding",
          "type": "text",
          "required": false,
          "prompt": [
            "Anything else I should know?",
            "Optional. Feel free to skip this one."
          ],
          "text": {
            "placeholder": "e.g. I train first thing, before eating",
            "multiline": true,
            "maxLength": 280
          },
          "skipLabel": "Skip"
        }
      ]
    },
    {
      "id": "finish",
      "title": "All set",
      "countsTowardProgress": false,
      "questions": [
        {
          "id": "summary",
          "stage": "onboarding",
          "type": "info",
          "prompt": [
            "That's everything! 🎉",
            "Look back over your answers if you want to change anything, or hit continue and I'll build your plan."
          ],
          "continueLabel": "Create my plan"
        }
      ]
    }
  ]
}
