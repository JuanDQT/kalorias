          "options": [
            {
              "id": "slow",
              "title": "Tranquilo",
              "description": "0,25 kg por semana. Menos grasa de propina",
              "emoji": "🐢"
            },
            {
              "id": "steady",
              "title": "Constante",
              "description": "0,5 kg por semana",
              "emoji": "🚶"
            }
          ]
        }
      ]
    },
