            },
            {
              "id": "steady",
              "title": "Constante",
              "description": "0,5 kg por semana. El más recomendable",
              "emoji": "🚶"
            },
            {
              "id": "fast",
              "title": "Rápido",
              "description": "0,75 kg por semana. Exige más disciplina",
              "emoji": "⚡"
            }
          ]
        },
        {
          "id": "goal_pace_gain",
          "stage": "onboarding",
          "type": "single_choice",
          "visibleIf": {
            "all": [
              {
                "questionId": "goal_primary",
                "operator": "equals",
                "value": "gain_muscle"
              }
            ]
          },
          "prompt": [
            "¿A qué ritmo quieres ganarlo?"
