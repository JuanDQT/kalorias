{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kalorias.app/schemas/questionnaire-v1.json",
  "title": "Kalorias questionnaire source, v1",
  "description": "Valida el fichero fuente del cuestionario. Las reglas que un esquema no puede expresar (referencias cruzadas entre preguntas, orden) las comprueba validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["onboardingId", "schemaVersion", "contentVersion", "locale", "sections"],
  "properties": {
    "onboardingId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "contentVersion": { "type": "integer", "minimum": 1 },
    "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } }
  },

  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 40 },

    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "questions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "countsTowardProgress": { "type": "boolean", "default": true },
        "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } }
      }
    },

    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stage", "type", "prompt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "stage": { "enum": ["onboarding", "profile"] },
        "type": { "enum": ["info", "single_choice", "multi_choice", "text", "number", "date", "measure"] },
        "prompt": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "required": { "type": "boolean", "default": true },
        "skipLabel": { "type": "string" },
        "continueLabel": { "type": "string" },
        "confirmLabel": { "type": "string" },
        "visibleIf": { "$ref": "#/$defs/conditionGroup" },
        "options": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/option" } },
        "allowsCustom": { "$ref": "#/$defs/allowsCustom" },
        "validation": { "$ref": "#/$defs/validation" },
        "crossChecks": { "type": "array", "items": { "$ref": "#/$defs/crossCheck" } },
        "text": { "$ref": "#/$defs/textConfig" },
        "number": { "$ref": "#/$defs/numberConfig" },
        "date": { "$ref": "#/$defs/dateConfig" },
        "measure": { "$ref": "#/$defs/measureConfig" }
      },

      "allOf": [
        {
          "if":   { "properties": { "type": { "enum": ["single_choice", "multi_choice"] } }, "required": ["type"] },
          "then": { "required": ["options"] },
          "else": { "not": { "required": ["options"] } }
        },
        {
          "if":   { "properties": { "type": { "const": "multi_choice" } }, "required": ["type"] },
          "then": { "required": ["confirmLabel"] },
          "else": { "not": { "required": ["allowsCustom"] } }
        },
        {
          "if":   { "properties": { "type": { "const": "info" } }, "required": ["type"] },
          "then": { "required": ["continueLabel"] }
        },
        {
          "if":   { "properties": { "type": { "const": "measure" } }, "required": ["type"] },
          "then": { "required": ["measure"] }
        },
        {
          "if":   { "properties": { "type": { "const": "date" } }, "required": ["type"] },
          "then": { "required": ["date"] }
        },
        {
          "if":   { "properties": { "type": { "const": "text" } }, "required": ["type"] },
          "then": { "required": ["text"] }
        },
        {
          "if":   { "properties": { "type": { "const": "number" } }, "required": ["type"] },
          "then": { "required": ["number"] }
        },
        {
          "if":   { "required": ["skipLabel"] },
          "then": { "properties": { "required": { "const": false } } }
        }
      ]
    },

    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "emoji": { "type": "string", "minLength": 1, "maxLength": 8 },
        "exclusive": { "type": "boolean", "default": false }
      }
    },

    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "operator"],
      "properties": {
        "questionId": { "$ref": "#/$defs/id" },
        "operator": { "enum": ["equals", "notEquals", "contains", "notContains", "answered", "notAnswered"] },
        "value": { "type": "string" }
      },
      "allOf": [
        {
          "if":   { "properties": { "operator": { "enum": ["answered", "notAnswered"] } }, "required": ["operator"] },
          "then": { "not": { "required": ["value"] } },
          "else": { "required": ["value"] }
        }
      ]
    },

    "conditionGroup": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } },
        "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } }
      }
    },

    "allowsCustom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "label", "maxItems", "maxLength"],
      "properties": {
        "enabled": { "type": "boolean" },
        "label": { "type": "string", "minLength": 1 },
        "placeholder": { "type": "string" },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 120 }
      }
    },

    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minSelections": { "type": "integer", "minimum": 0 },
        "maxSelections": { "type": "integer", "minimum": 1 },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 1 }
      }
    },

    "crossCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "rule", "compareTo", "message"],
      "properties": {
        "severity": { "enum": ["warning", "error"] },
        "rule": { "enum": ["lessThan", "greaterThan", "lessThanOrEqual", "greaterThanOrEqual", "notEqual"] },
        "compareTo": { "$ref": "#/$defs/id" },
        "when": { "$ref": "#/$defs/conditionGroup" },
        "message": { "type": "string", "minLength": 1 }
      }
    },

    "textConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxLength"],
      "properties": {
        "placeholder": { "type": "string" },
        "multiline": { "type": "boolean", "default": false },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },

    "numberConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "step", "decimals"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "default": { "type": "number" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 3 },
        "unit": { "type": "string" }
      }
    },

    "dateConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "minDate", "maxDate"],
      "properties": {
        "mode": { "enum": ["date", "dateTime"] },
        "minDate": { "$ref": "#/$defs/dateToken" },
        "maxDate": { "$ref": "#/$defs/dateToken" },
        "default": { "$ref": "#/$defs/dateToken" },
        "displayFormat": { "enum": ["short", "long"] }
      }
    },

    "dateToken": {
      "type": "string",
      "description": "ISO-8601 (1993-04-18) o token relativo resuelto en el dispositivo: today, today-16y, today+30d.",
      "pattern": "^(\\d{4}-\\d{2}-\\d{2}|today([+-]\\d+[dmy])?)$"
    },

    "measureConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widget", "canonicalUnit", "defaultUnit", "units"],
      "properties": {
        "widget": { "enum": ["wheel"] },
        "canonicalUnit": { "$ref": "#/$defs/id" },
        "defaultUnit": { "$ref": "#/$defs/id" },
        "unitFollows": { "$ref": "#/$defs/id" },
        "defaultFollows": { "$ref": "#/$defs/id" },
        "units": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/unit" } }
      }
    },

    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "components"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "components": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/unitComponent" } }
      }
    },

    "unitComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "min", "max", "step", "default", "decimals", "toCanonical"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "default": { "type": "number" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 3 },
        "toCanonical": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
